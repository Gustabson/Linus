# ─────────────────────────────────────────────────────────────────────────────
# Base de datos (PostgreSQL)
# Recomendado: https://neon.tech — plan gratuito suficiente para desarrollo
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contraseña@host:5432/eduhub?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth v5
# Generá AUTH_SECRET con: openssl rand -base64 32
# AUTH_URL es la URL pública canónica (NextAuth v5 — reemplazo de NEXTAUTH_URL)
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# OAuth — opcionales, solo necesarios si querés login con Google / GitHub
# ─────────────────────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Resend — emails de verificación y notificaciones
# https://resend.com — plan gratuito: 100 emails/día
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Debe ser un dominio verificado en tu cuenta de Resend (no usar onboarding@resend.dev en producción)
RESEND_FROM_EMAIL="EduHub <noreply@tudominio.com>"

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Blob — avatares y archivos adjuntos
# https://vercel.com/docs/storage/vercel-blob
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# URL pública de la app (sin slash final)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
